# ─────────────────────────────────────────────────────────────
# TERRA FORCE — configuración de contacto
# Copia este archivo como .env.local y rellena los valores reales.
# Si una variable queda vacía, la web muestra un placeholder
# claramente identificado en lugar de un dato inventado.
# ─────────────────────────────────────────────────────────────

# Número de WhatsApp en formato internacional, sólo dígitos (ej. 34XXXXXXXXX)
VITE_WHATSAPP_NUMBER=

# Mensaje inicial del chat de WhatsApp
VITE_WHATSAPP_MESSAGE=Hola, me gustaría solicitar un presupuesto.

# Datos visibles en la sección de contacto
VITE_CONTACT_PHONE=
VITE_CONTACT_EMAIL=
VITE_CONTACT_ADDRESS=
VITE_SERVICE_AREA=

# Endpoint opcional (POST JSON) para recibir el formulario.
# Vacío = modo demostración (no se envía nada).
VITE_FORM_ENDPOINT=
